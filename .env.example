# ===================================================
# Smart Attendance Web - Environment Variables
# ===================================================
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
# Copy this to .env.local and fill in actual values
# ===================================================

# Face AI (titan-auth-api-main)
# URL นี้ต้องลงท้ายด้วย /api/verify_face
VITE_FACE_API_URL=https://YOUR_FACE_NGROK_URL.ngrok-free.dev/api/verify_face
# ไม่ต้องใส่หาก API มี endpoint /enroll ตามปกติ ระบบจะสร้าง URL ให้เอง
VITE_API_URL_ENROLL=https://YOUR_FACE_NGROK_URL.ngrok-free.dev/api/enroll

# CCTV / Gait AI (Gesture-Recognition-master)
# ใช้ base URL เท่านั้น ไม่ต้องต่อ /api/cctv
VITE_CCTV_API_URL=https://YOUR_CCTV_NGROK_URL.ngrok-free.dev

# Attendance DB API (Node.js + MongoDB)
VITE_ATTENDANCE_API_URL=https://YOUR_ATTENDANCE_API_URL

# สำหรับรันหน้าเว็บบนเครื่อง ให้เปลี่ยนเป็น:
# VITE_FACE_API_URL=http://localhost:8000/api/verify_face
# VITE_API_URL_ENROLL=http://localhost:8000/api/enroll
# VITE_CCTV_API_URL=http://localhost:8001
# VITE_ATTENDANCE_API_URL=http://localhost:3000
